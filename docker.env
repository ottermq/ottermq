# OtterMQ Configuration
# Copy this file to .env and modify the values as needed
# Environment variables will override .env file values

# Broker Configuration
OTTERMQ_SHOW_LOGO=false
OTTERMQ_BROKER_PORT=5672
OTTERMQ_BROKER_HOST=
OTTERMQ_DATA_DIR=data

# AMQP Protocol Settings
OTTERMQ_HEARTBEAT_INTERVAL=60
OTTERMQ_CHANNEL_MAX=2048
OTTERMQ_FRAME_MAX=131072
OTTERMQ_SSL=false

# Queue Configuration
OTTERMQ_QUEUE_BUFFER_SIZE=100000
OTTERMQ_MAX_PRIORITY=10  # Max priority for queues (0-255)

# Extensions
OTTERMQ_ENABLE_DLX=true
OTTERMQ_ENABLE_TTL=true
OTTERMQ_ENABLE_QLL=true # QLL: Queue Length Limit

# Plugins
OTTERMQ_ENABLE_WEB_API=true
OTTERMQ_ENABLE_UI=true
OTTERMQ_ENABLE_SWAGGER=true
OTTERMQ_WEB_API_PATH=/api   # no trailing slash
OTTERMQ_SWAGGER_PATH=/swagger  # no trailing slash

# Web Server Configuration
OTTERMQ_WEB_PORT=3000

# Authentication
OTTERMQ_USERNAME=guest
OTTERMQ_PASSWORD=guest

# Security
OTTERMQ_JWT_SECRET=secret

# Logging Configuration
# Available levels: trace, debug, info, warn, error
LOG_LEVEL=info

OTTERMQ_ENABLE_METRICS=true
OTTERMQ_METRICS_WINDOW_SIZE=5m
OTTERMQ_METRICS_MAX_SAMPLES=60
OTTERMQ_METRICS_SAMPLES_INTERVAL=5

# Prometheus Metrics Configuration
OTTERMQ_ENABLE_PROMETHEUS=false
OTTERMQ_PROMETHEUS_PORT=9093
OTTERMQ_PROMETHEUS_PATH=/metrics

# Docker host ports
OTTERMQ_DOCKER_BROKER_PORT=5672
OTTERMQ_DOCKER_WEB_PORT=3333
OTTERMQ_DOCKER_PROMETHEUS_PORT=9093
